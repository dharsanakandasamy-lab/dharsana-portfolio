# Dependencies
node_modules/
frontend/node_modules/

# Production build outputs (built on Render during deployment)
frontend/dist/
dist/

# Local media uploads, local database, and backups (avoid committing user data)
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/*
!backend/data/.gitkeep
backend/backup/*
!backend/backup/.gitkeep

# Environment and sensitive keys
.env
.env.*
.env.local
!.env.example

# Logs and OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.vscode/
